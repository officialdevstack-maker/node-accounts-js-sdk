{
  "name": "@spurs/auth",
  "version": "2.0.0",
  "description": "JavaScript SDK for Spurs Accounts (OpenID Connect, authorization code + PKCE)",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spurs/node-accounts.git",
    "directory": "sdk/js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./service": {
      "types": "./dist/src/service.d.ts",
      "default": "./dist/src/service.js"
    },
    "./next": {
      "types": "./dist/src/next.d.ts",
      "default": "./dist/src/next.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "default": "./dist/src/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
